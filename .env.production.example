# Produção — copie para .env no servidor e preencha. NUNCA versione o .env.

# Domínio público apontando (registro DNS A) para o IP do servidor.
# O Caddy emite o certificado HTTPS sozinho.
SAGE_DOMAIN=sage.seudominio.com.br

# Chave da aplicação Laravel. Gere com: make prod-key
APP_KEY=

# Banco MySQL (só acessível dentro do Docker). Use senhas longas e aleatórias:
#   openssl rand -base64 24
MYSQL_DATABASE=sage
MYSQL_USER=sage
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Primeiro gestor do Painel, criado por: make prod-seed (senha com 12+ caracteres)
SAGE_ADMIN_NAME=Gestor S.A.G.E.
SAGE_ADMIN_EMAIL=
SAGE_ADMIN_PASSWORD=

# LLM da resposta do Agente: template (sem chave) | gemini | openai | anthropic | ollama
LLM_PROVIDER=template
LLM_API_KEY=
LLM_MODEL=
SISTEMA_LEGADO_NOME=GLPI

# Usuário de teste do sistema legado para "Simular atendimento" (opcional)
SIMULATION_ERP_LOGIN=
SIMULATION_ERP_PASSWORD=
