# Portas expostas no host (evitar colisão com SistemaLegado/glpi: 8080, 8090, 9637, 8025, 9000)
BACKEND_PORT=8000
FRONTEND_PORT=4200
DB_PORT=3307
ADMINER_PORT=8081
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
AGENT_PORT=8001

# Credenciais do MySQL (dev) — devem bater com painel-backend/.env
MYSQL_DATABASE=sage
MYSQL_USER=sage
MYSQL_PASSWORD=sage
MYSQL_ROOT_PASSWORD=root

# UID/GID do usuário do host, para os containers não gravarem arquivos como root
UID=1000
GID=1000

# Agente Python (Fase 2) — geração da resposta final do chat.
# 'template' (padrão): monta a resposta só com o que foi recuperado no Qdrant,
# sem chamar nenhuma API externa nem precisar de chave. Funciona sempre.
# Trocar para 'ollama' | 'openai' | 'anthropic' | 'gemini' para usar um LLM de
# verdade na formulação da resposta (preencher LLM_API_KEY/LLM_MODEL nesse caso).
LLM_PROVIDER=template
LLM_API_KEY=
LLM_MODEL=

# Nome do sistema legado atendido pelo Agente (como ele se refere ao sistema nas respostas)
SISTEMA_LEGADO_NOME=GLPI

# Usuário de teste do sistema legado usado por padrão em "Simular atendimento" (ver seed/usuario_simulacao.php; perfil Super-Admin).
SIMULATION_ERP_LOGIN=
SIMULATION_ERP_PASSWORD=

# Endereço da API do Painel como o servidor do sistema legado o enxerga: é para
# onde ele manda as mensagens do chat (aparece em Chaves de acesso). O GLPI de
# desenvolvimento roda em outro docker compose e chega ao Painel pelo host.
SAGE_PUBLIC_API_URL=http://host.docker.internal:8000/api/v1

# O endereço da API do plugin do sistema legado (manifesto e execução de funções)
# não é configurado aqui: ele é cadastrado no Painel, em Chaves de acesso, junto
# com cada chave de execução. No ambiente de desenvolvimento com o GLPI, use
# http://host.docker.internal:8080/plugins/sage/api

# Chave de execução cadastrada por padrão pelo seeder (make seed / make fresh).
# Use a mesma configurada no plugin S.A.G.E. do GLPI (que guarda só o hash). Se
# ficar vazia, o seeder gera uma chave nova e mostra o valor para configurar no plugin.
SEED_ERP_EXECUTION_KEY=
SEED_ERP_API_URL=http://host.docker.internal:8080/plugins/sage/api
